PORT = # your port (default 5000)
NODE_ENV = # your node environment (development | production)
DB_PATH = # sqlite file (default ./db/ezups.sqlite)
UPLOADS_DIR = # uploaded files (default ./uploads)
LOG_DIR = # log directory (default ./logs)
PURGE_MAX_AGE_DAYS = # daily sweep retention in days, 0 = keep forever (default 7)
MAX_UPLOAD_SIZE = # per-file cap in bytes (default 104857600 = 100MB)
DB_AUTO_RECOVER = # 1 = quarantine a corrupt db and create a fresh one, 0 = exit (default 1)
DB_MAX_RECOVERIES = # recoveries per process before giving up (default 3)
DB_KEEP_QUARANTINES = # quarantined *.corrupt-* files to keep (default 3)